# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend
RESEND_API_KEY=re_your_key_here

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_key
PAYSTACK_SECRET_KEY=sk_test_your_key

# ── Internal admin (HTTP Basic, enforced in proxy.ts) ────────────────────────
ADMIN_USER=
ADMIN_PASSWORD=

# Superadmin credential. REQUIRED for /admin/partners and /admin/routing: without
# both, those pages answer 503 (they never fall back to the login above). Use a
# different user name and a long random password.
ADMIN_SUPER_USER=
ADMIN_SUPER_PASSWORD=

# ── Verified partner programme ───────────────────────────────────────────────
# Also needs NEXT_PUBLIC_SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY (above) and the
# supabase/partners.sql migration applied by hand. RESEND_API_KEY sends the emails.
#
# Public endpoints /api/partner-apply and /api/partner-status stay disabled (503)
# unless this is exactly 1. Leave unset until a public form posts to them.
PARTNER_APPLICATIONS_OPEN=
# Partner portal only (not built yet): HMAC key for portal login links, at least
# 32 random characters. Unset = portal login refuses everybody.
PARTNER_TOKEN_SECRET=
