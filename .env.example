# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend
RESEND_API_KEY=re_your_key_here

# Paystack
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_your_key
PAYSTACK_SECRET_KEY=sk_test_your_key

# ── Internal admin (HTTP Basic, enforced in proxy.ts) ────────────────────────
ADMIN_USER=
ADMIN_PASSWORD=

# Second credential tier. When both are set, /admin/partners and /admin/routing
# need these instead of the general admin login — approving a partner publishes
# our name beside theirs, so it is deliberately a separate, senior credential.
ADMIN_SUPER_USER=
ADMIN_SUPER_PASSWORD=

# ── Verified partner pipeline (see PARTNER-PIPELINE.md) ─────────────────────
# Pepper for hashing partner portal links (sha256(secret + token)). Without it,
# /partner refuses to log anybody in rather than fall back to something weak.
PARTNER_TOKEN_SECRET=
# Our own commission account, shown to partners in their portal. Leave unset and
# the portal says "ask us for the account details" instead.
PARTNER_BANK_NAME=
PARTNER_ACCOUNT_NAME=
PARTNER_ACCOUNT_NUMBER=
